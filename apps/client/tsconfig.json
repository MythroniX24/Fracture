{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false
  },
  // Includes the UI render tests so they are type-checked with the app.
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.tsx", "vite.config.ts"]
}

{
  "name": "fracture-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace @fracture/shared && npm run build --workspace @fracture/server && npm run build --workspace @fracture/client",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "smoke:solo": "node scripts/smoke-solo.mjs",
    "start": "npm run start --workspace @fracture/server"
  },
  "devDependencies": {
    "zx": "^8.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

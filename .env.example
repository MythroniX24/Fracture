# ---------------------------------------------------------------------------
# FRACTURE — server configuration (copy to `.env` for local development)
# Never commit real values. These are placeholders only.
# ---------------------------------------------------------------------------

# TCP port the authoritative game server (HTTP + WebSocket) listens on.
PORT=2567

# Interface to bind. Use 0.0.0.0 when running inside a container/VM that must
# be reachable from outside, or 127.0.0.1 for loopback-only development.
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to open a WebSocket.
# Use `*` to allow any origin (development only).
CLIENT_ORIGIN=*

# Serve the built client (apps/client/dist) from the same server process.
# Set to false when the client is deployed to a separate static host/CDN.
SERVE_CLIENT=true

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# FRACTURE — client configuration (Vite exposes only VITE_* variables).
# Set these in `apps/client/.env` when the server is not on the same origin.
# ---------------------------------------------------------------------------

# WebSocket endpoint of the game server. Leave empty to auto-derive from the
# page origin (ws://<host>/ws or wss://<host>/ws).
# VITE_SERVER_WS_URL=ws://localhost:2567/ws
